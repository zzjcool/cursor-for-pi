{
  "name": "cursor-for-pi",
  "version": "0.1.0",
  "description": "Cursor provider for the Pi coding agent. One HTTP/2 Run per turn.",
  "license": "MIT",
  "type": "module",
  "keywords": ["pi-package"],
  "engines": {
    "node": ">=22"
  },
  "files": [
    "src",
    "LICENSE",
    "README.md"
  ],
  "main": "./src/index.ts",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.ts",
    "check": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "5.9"
  }
}
